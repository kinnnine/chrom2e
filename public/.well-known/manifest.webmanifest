{
  "id": "/",
  "name": "Chrom2e",
  "short_name": "Chrom2e",
  "description": "Isolated 2nd-browser made for ChromeOS.",
  "version": "0.1.0",
  "start_url": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "minimal-ui"
  ],
  "background_color": "#000000",
  "theme_color": "#0D0D0D",
  "isolated_storage": true,
  "permissions_policy": {
    "cross-origin-isolated": [
      "self"
    ],
    "controlled-frame": [
      "self"
    ]
  },
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}